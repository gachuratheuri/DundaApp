# Frontend runtime configuration (Expo).
# Copy to `.env` for local overrides. Variables prefixed with EXPO_PUBLIC_ are
# inlined into the JS bundle at build time.

# Origin of the Dunda Elixir API (scheme + host[:port], NO trailing slash).
# The REST base (/api) and Phoenix socket (/socket, ws[s]) are derived from this.
#   - Android emulator (dev):  http://10.0.2.2:4000
#   - iOS sim / web (dev):     http://localhost:4000
#   - Staging / production:    https://api.tiketa.ke   (use HTTPS)
EXPO_PUBLIC_API_URL=http://localhost:4000
# Demo events are allowed only in local development; never enable this in a
# preview or production EAS profile.
EXPO_PUBLIC_ENABLE_DEMO_DATA=true
